# Isolated database for unit/integration/E2E — NEVER production.
# Copy to .env.test and adjust. Used by:
#   npm run test:db:prepare
#   npm run test:data-layer
#   npm run test:e2e

TEST_DATABASE_URL="postgresql://nexlify:nexlify@127.0.0.1:5432/nexlify_test"
DATABASE_URL="postgresql://nexlify:nexlify@127.0.0.1:5432/nexlify_test"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET="e2e-test-jwt-secret-change-me-32chars-min"
ENCRYPTION_AT_REST_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PANEL_INTERNAL_SECRET="e2e-panel-internal-secret"
CRON_SECRET="e2e-cron-secret"
BILLING_WEBHOOK_SECRET="e2e-billing-webhook"

# Bypass license gate for local E2E (middleware checks this)
NEXLIFY_LICENSE_VALID=1

NEXT_PUBLIC_PANEL_NAME="Nexlify E2E"
PORT=13100
PANEL_PORT=13100
E2E_PORT=13100

# Optional: point Playwright at an already-running panel instead of webServer
# E2E_BASE_URL=http://127.0.0.1:13100

# Prefer system Edge/Chrome if Playwright Chromium isn't installed
# PW_CHANNEL=msedge

# --- Load tests (k6) — never production ---
# LOAD_BASE_URL=http://127.0.0.1:13100
# LOAD_CHANNEL_COUNT=10000
# LOAD_AUTH_VUS=1000
# LOAD_LIVE_AUTH_VUS=5000

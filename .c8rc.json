{
  "all": true,
  "reporter": ["text", "text-summary", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 70,
  "branches": 60,
  "functions": 60,
  "statements": 70,
  "include": [
    "tests/mocks/**",
    "tests/helpers/prisma.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.mjs",
    "tests/factories/**"
  ],
  "skip-full": true
}

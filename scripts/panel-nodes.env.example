# Three-node IPTV panel update contract (copy to panel-nodes.env — not committed).
# Node 1 = production panel (never compile into live .next)
# Node 2 = verify / canary
# Node 3 = staging compile + tarball
PANEL_NODE_1=panel-prod.example
PANEL_NODE_2=panel-canary.example
PANEL_NODE_3=panel-staging.example
# Node 3 compiles on the same host as node 1, but ONLY into .next.staging.
# Live .next on node 1 is never written until pipeline apply succeeds.

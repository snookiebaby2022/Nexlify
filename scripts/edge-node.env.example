# Remote IPTV edge node (no Postgres — points at panel for auth)
# Copy to /opt/nexlify-panel/.env on a dedicated edge VPS.

PANEL_PRIMARY_DOMAIN=stream2.example.com
NEXLIFY_USE_IPTV_EDGE=1

# Panel backend (private IP or VPN — NOT public panel URL for auth API)
IPTV_EDGE_BACKEND=10.0.0.5:13000
INTERNAL_API_SECRET=same-as-panel-internal-secret

# Edge listens locally; nginx or LB terminates TLS in front
IPTV_EDGE_HTTP_PORTS=8080,25461
STREAM_EDGE_PORT=8080
STREAM_HTTP_EXTRA_PORTS=8080,25461
STREAM_HTTPS_PORT=
IPTV_EDGE_HTTPS_PORTS=

# No panel workers on edge-only nodes
PANEL_INSTANCES=0

# Edge scale (2k–5k viewers per node)
IPTV_EDGE_UPSTREAM_SOCKETS=8192
IPTV_EDGE_LIVE_SOCKETS=1024
IPTV_EDGE_VOD_SOCKETS=512
IPTV_EDGE_MAX_HLS_REMUX=96
IPTV_EDGE_MAX_DISK_PACK=64
IPTV_EDGE_AUTH_CACHE_MS=120000
IPTV_EDGE_CATALOG_CACHE_MS=300000
IPTV_EDGE_CATALOG_STALE_MS=600000

UV_THREADPOOL_SIZE=64

# Stream agent (optional — reports metrics to panel)
# PANEL_URL=https://panel.example.com
# AGENT_TOKEN=from-admin-servers

# /etc/nexlify-lb/lb.env — chmod 640, group www-data
PANEL_URL=https://panel.example.com
AGENT_TOKEN=replace-me
PANEL_INTERNAL_SECRET=
LB_SERVER_ID=

# mysql (default, rich Open Connections) | redis (hot path for high concurrency)
CONNECTION_HANDLER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexlify_lb
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nexlify_lb
MYSQL_PERSISTENT=1
REDIS_URL=redis://127.0.0.1:6379/2

FFMPEG_BIN=/usr/local/bin/ffmpeg
STREAM_ROOT=/var/lib/nexlify-lb
LISTEN_HTTP=8090
# Dedicated LB with free :8080 → LISTEN_HTTP=8080

FFMPEG_IDLE_SECS=90
AUTH_CACHE_SECS=25

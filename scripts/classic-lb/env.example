# /etc/nexlify-lb/lb.env — chmod 640, group www-data
PANEL_URL=https://panel.example.com
AGENT_TOKEN=replace-me
PANEL_INTERNAL_SECRET=
LB_SERVER_ID=

# mysql (small box) | redis (default — 50k lines / multi-LB)
CONNECTION_HANDLER=redis
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexlify_lb
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nexlify_lb
MYSQL_PERSISTENT=1
REDIS_URL=redis://127.0.0.1:6379/2

FFMPEG_BIN=/usr/local/bin/ffmpeg
STREAM_ROOT=/var/lib/nexlify-lb
LISTEN_HTTP=8090
# Dedicated LB with free :8080 → LISTEN_HTTP=8080

# Shared packager segment length (1 = fastest zap; 2–4 = fewer segments)
HLS_TIME=1
HLS_LIST_SIZE=10
# HMAC for public /lb/hls/{safe}/segN.ts links (defaults to AGENT_TOKEN)
# HLS_SIGN_SECRET=
HLS_SIGN_TTL=900
# XUI-style /live/{token}/id and /play/{token} (defaults to PANEL_INTERNAL_SECRET)
# PLAY_TOKEN_SECRET=

FFMPEG_IDLE_SECS=300
# Restart packager if PID alive but no fresh segment for N seconds (viewers present)
FFMPEG_STALE_SECS=12
# HTTP input read timeout (microseconds) + reconnect backoff cap (seconds)
FFMPEG_RW_TIMEOUT_US=20000000
FFMPEG_RECONNECT_DELAY_MAX=5
AUTH_CACHE_SECS=90
# Max ms auth_request waits for first HLS playlist (.m3u8 only; .ts never waits)
AUTH_READY_WAIT_MS=4000
# How long Redis/MySQL keeps a live connection without heartbeat (mpegts heartbeats ~10s)
CONN_TTL_SECS=600

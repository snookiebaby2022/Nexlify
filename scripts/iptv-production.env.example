# Nexlify IPTV production environment
# Copy relevant lines into .env on panel/edge servers.
# Run: bash scripts/ensure-panel-env.sh  (applies safe defaults)

# --- Panel core ---
PANEL_PRIMARY_DOMAIN=darkcdn.store
PORT=13000
PANEL_PORT=13000
PANEL_BIND_HOST=127.0.0.1
PANEL_BEHIND_NGINX=1
PANEL_PUBLIC_PORT=443
PANEL_ASSUME_PROXY_SSL=1
PANEL_TRUST_CLOUDFLARE=1
NEXT_PUBLIC_SERVER_URL=https://darkcdn.store
NEXT_PUBLIC_WEBSITE_URL=https://darkcdn.store

# --- IPTV edge (video gateway) ---
NEXLIFY_USE_IPTV_EDGE=1
STREAM_HTTP_PORT=8080
STREAM_EDGE_PORT=8080
STREAM_HTTP_EXTRA_PORTS=8080,25461
# nginx owns TLS on domain panels — leave empty:
STREAM_HTTPS_PORT=
IPTV_EDGE_HTTPS_PORTS=
IPTV_EDGE_HTTP_PORTS=8080,25461
IPTV_EDGE_BACKEND=127.0.0.1:13000

# Remote edge only: point at panel internal IP
# IPTV_EDGE_BACKEND=10.0.0.5:13000
# INTERNAL_API_SECRET=...

# --- Panel workers (auth/admin only — NOT video) ---
PANEL_INSTANCES=4
NEXLIFY_PANEL_WORKER_SPARE=1
NEXLIFY_PANEL_INSTANCES_MAX=6
NEXLIFY_MAX_MEMORY_RESTART=4096M
NEXLIFY_STREAMING_OPTIMIZED=1
UV_THREADPOOL_SIZE=32

# --- Edge socket pools ---
IPTV_EDGE_UPSTREAM_SOCKETS=4096
IPTV_EDGE_LIVE_SOCKETS=512
IPTV_EDGE_ADMIN_SOCKETS=256
IPTV_EDGE_VOD_SOCKETS=256

# --- Edge caches (milliseconds) ---
IPTV_EDGE_AUTH_CACHE_MS=120000
IPTV_EDGE_CATALOG_CACHE_MS=300000
IPTV_EDGE_CATALOG_STALE_MS=600000

# --- HLS / disk packager at edge ---
IPTV_EDGE_DISK_HLS_WAIT_MS=6000
IPTV_EDGE_HLS_SEG_WAIT_MS=12000
IPTV_EDGE_MAX_HLS_REMUX=64
IPTV_EDGE_MAX_DISK_PACK=48
IPTV_EDGE_TS_OPEN_MS=2000
IPTV_EDGE_SESSION_IDLE_MS=3000

# --- Connections & rate limits ---
NEXLIFY_CONN_STALE_SEC=60
PLAYBACK_RATE_LIMIT_PER_MIN=120
STREAM_PROBE_TIMEOUT_MS=4000

# --- Redis (required for auth + catalog hot path) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Database (panel server only) ---
# DATABASE_URL=postgresql://nexlify:secret@127.0.0.1:5432/nexlify
# With PgBouncer:
# DATABASE_URL=postgresql://nexlify:secret@127.0.0.1:6432/nexlify?pgbouncer=true

# --- Multi-edge LB (install-multi-edge-lb.sh) ---
# EDGE_IPS=45.88.138.18,75.119.137.174
# STREAM_HOST=darkcdn.store
# EDGE_PORT=8080

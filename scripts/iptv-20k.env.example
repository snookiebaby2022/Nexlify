# Nexlify IPTV — 20k concurrent viewers (panel + edge fleet)
# Apply on panel server first, then edge nodes. See docs/IPTV-SCALE.md

# --- Panel (single writer DB) ---
PANEL_INSTANCES=6
NEXLIFY_PANEL_INSTANCES_MAX=8
NEXLIFY_CONN_STALE_SEC=45
PLAYBACK_RATE_LIMIT_PER_MIN=180

# PgBouncer (after install-pgbouncer.sh)
# DATABASE_URL=postgresql://nexlify:secret@127.0.0.1:6432/nexlify?pgbouncer=true
# Read replica for reporting (optional)
# DATABASE_READ_URL=postgresql://nexlify:secret@replica-ip:5432/nexlify

# Redis production
REDIS_URL=redis://127.0.0.1:6379
NEXLIFY_REDIS_MAXMEMORY=2048mb

# Edge fleet (each node)
IPTV_EDGE_UPSTREAM_SOCKETS=8192
IPTV_EDGE_LIVE_SOCKETS=2048
IPTV_EDGE_VOD_SOCKETS=1024
IPTV_EDGE_MAX_HLS_REMUX=128
IPTV_EDGE_MAX_DISK_PACK=96
IPTV_EDGE_AUTH_CACHE_MS=180000
IPTV_EDGE_CATALOG_CACHE_MS=600000
IPTV_EDGE_CATALOG_STALE_MS=900000
UV_THREADPOOL_SIZE=64

# Multi-edge LB
# EDGE_IPS=45.88.138.18,75.119.137.174,10.0.0.6,10.0.0.7
# STREAM_HOST=darkcdn.store

# Kernel (tune-kernel-20k.sh)
# NEXLIFY_NET_CORE_SOMaxCONN=65535

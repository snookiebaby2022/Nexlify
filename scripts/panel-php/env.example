# Nexlify PHP panel (Xtream control plane) — Phase 1
# Copied to /etc/nexlify-panel/panel.env by install.sh

# Postgres (same DB as Next panel)
DATABASE_URL=postgresql://nexlify:CHANGE_ME@127.0.0.1:5432/nexlify

# Redis (auth / catalog short cache) — use a different DB index than classic-lb
REDIS_URL=redis://127.0.0.1:6379/3

# Must match panel PANEL_INTERNAL_SECRET / classic-lb AGENT auth
PANEL_INTERNAL_SECRET=CHANGE_ME
AGENT_TOKEN=

# Advertised defaults (server_info)
STREAM_HTTP_PORT=80
STREAM_HTTPS_PORT=443
PANEL_TIMEZONE=Europe/London

# Auth cache TTL seconds (50k lines: keep ≥60 to blunt player_api storms)
AUTH_CACHE_SECS=90
CATALOG_CACHE_SECS=60

# XUI-style play tokens (optional). When 1, get.php/playlist emit /live/{token}/{id}.ts
# PLAY_TOKEN_URLS=0
# PLAY_TOKEN_SECRET=  # defaults to PANEL_INTERNAL_SECRET
